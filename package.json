{
  "name": "promptpen",
  "version": "0.3.0",
  "private": true,
  "description": "AI-powered writing assistant for any text field",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "check": "ultracite check",
    "clean": "rm -rf .output .wxt",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "doctor": "npx react-doctor@latest",
    "fix": "ultracite fix",
    "postinstall": "wxt prepare",
    "publish": "wxt publish",
    "zip": "wxt zip",
    "zip:all": "wxt zip -b firefox -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/cohere": "^4.0.25",
    "@ai-sdk/deepseek": "^3.0.26",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/groq": "^4.0.26",
    "@ai-sdk/mistral": "^4.0.27",
    "@ai-sdk/openai": "^4.0.36",
    "@base-ui/react": "^1.7.0",
    "@browser-ai/transformers-js": "^3.0.0",
    "@floating-ui/react": "^0.27.20",
    "@huggingface/transformers": "^4.2.0",
    "@wxt-dev/storage": "^1.2.9",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "driver.js": "^1.8.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.1",
    "shadcn": "^4.16.2",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "react-hook-form": "^7.85.0",
    "typescript": "^7.0.2",
    "ultracite": "7.10.2",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.3"
  },
  "knip": {
    "entry": [
      "wxt.config.ts",
      "entrypoints/background.ts",
      "entrypoints/content.tsx",
      "entrypoints/options/main.tsx",
      "entrypoints/popup/main.tsx"
    ]
  }
}